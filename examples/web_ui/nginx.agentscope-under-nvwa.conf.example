# Fragment for the Nuwa gateway host. UI assets are built with
# VITE_PUBLIC_BASE_PATH=/agentscope/ (see frontend/.env.agentscope-embed).

location /agentscope/api/ {
    proxy_pass http://127.0.0.1:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 3600s;
}

location /agentscope/ {
    # Dev: Vite preview/dev with base /agentscope/
    # Prod: static root that contains the /agentscope/ build output
    proxy_pass http://127.0.0.1:5173/agentscope/;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
